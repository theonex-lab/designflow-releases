{
  "name": "DesignFlow",
  "version": "1.0",
  "theme": "light",
  "color": {
    "primary": "#6B17F5",
    "primaryHover": "#5810D4",
    "primarySubtle": "#EEE7FF",
    "text": "#151322",
    "muted": "#62657B",
    "surface": "#FFFFFF",
    "canvas": "#FBFAFF",
    "border": "#E8E4F2",
    "success": "#15806D",
    "danger": "#C93A58",
    "focusRing": "#A788FF"
  },
  "typography": {
    "family": "Inter, system-ui, Arial, sans-serif",
    "pageTitle": {
      "fontSize": 34,
      "lineHeight": 1.15,
      "weight": 700
