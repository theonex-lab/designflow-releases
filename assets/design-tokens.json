  "icon": {
    "set": "lucide-react",
    "defaultSize": 20,
    "strokeWidth": 1.8
  },
  "breakpointsPx": {
    "compact": 720,
    "tablet": 1024,
    "desktop": 1440
  },
  "motion": {
    "fastMs": 120,
    "normalMs": 180,
    "preferReducedMotion": true
  }
