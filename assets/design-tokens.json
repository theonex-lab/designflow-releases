    "sectionTitle": {
      "fontSize": 20,
      "weight": 600
    },
    "body": {
      "fontSize": 15,
      "lineHeight": 1.5,
      "weight": 400
    },
    "caption": {
      "fontSize": 13,
      "lineHeight": 1.45,
      "weight": 400
    }
  },
  "spacePx": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
