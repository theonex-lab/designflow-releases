  "radiusPx": {
    "small": 8,
    "medium": 12,
    "large": 16,
    "pill": 999
  },
  "layoutPx": {
    "sidebar": 264,
    "topbar": 88,
    "contentPaddingDesktop": 40,
    "contentMaxWidth": 1480,
    "gridGap": 22,
    "cardPadding": 22
